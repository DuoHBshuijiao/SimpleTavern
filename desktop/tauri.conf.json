{
  "productName": "SimpleTavern",
  "identifier": "io.github.duohbshuijiao.simpletavern",
  "build": { "frontendDist": [
    "ui/index.html", "ui/manager.js", "ui/manager.css", "ui/appearance.js",
    "../frontend/src/styles/variables.css", "../frontend/src/styles/components/buttons.css",
    "../frontend/src/styles/light.css", "../frontend/src/styles/scrollbar.css",
    "../frontend/src/utils/wallpaperScheme.mjs"
  ] },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "title": "SimpleTavern 服务管理器", "visible": false, "backgroundColor": "#151217", "width": 780, "height": 540, "minWidth": 460, "minHeight": 390 }],
    "security": { "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: blob:; connect-src ipc: http://ipc.localhost 'self'" }
  },
  "bundle": { "active": false, "icon": ["icons/icon.ico","icons/icon.png"] }
}
